// GradLeap on Cloudflare Workers — Workers FREE plan only.
//
// Everything below is available on the Free plan: static assets, Workers KV,
// workers.dev hosting and Workers Logs. Nothing here needs Workers Paid, and
// there are deliberately no cron triggers, Durable Objects, R2 buckets, queues
// or Images bindings.
//
// Secrets are NOT configured here. Set them once with Wrangler:
//   npx wrangler secret put DATABASE_URL
//   npx wrangler secret put AUTH_SECRET
// (see README.md → "Environment variables" for the full list)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gradlink",
  // Built by `opennextjs-cloudflare build` from the Next.js app.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  // nodejs_compat is required by the Next.js runtime; it also mirrors vars and
  // secrets onto process.env, which the API routes read.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Run the Worker next to the Neon database (Neon project "gradlink",
  // aws-ap-southeast-1, Singapore). One API request makes several queries in a
  // row, so they are made close to Neon and only the request itself travels.
  // Static files are still served from the visitor's nearest location.
  // Placement is available on every Workers plan, the Free plan included.
  "placement": { "mode": "targeted", "region": "aws:ap-southeast-1" },

  // Pages, JS/CSS and prerendered HTML. Static asset requests are free and
  // don't count against the Free plan's daily Worker request limit.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Résumés, brochures and logos.
  // Namespace "UPLOADS" in the owner's Cloudflare account (the one serving
  // gradlink.divitkej.workers.dev and the gradleap.online zone).
  "kv_namespaces": [
    {
      "binding": "UPLOADS",
      "id": "c980a36355cf49e0836f8d9fff403b69"
    }
  ],

  // The custom domain, registered at Hostinger with its nameservers on
  // Cloudflare. Deploy attaches both hostnames to this Worker and creates their
  // DNS records and certificates. The zone must be in the same Cloudflare
  // account, and no other A, AAAA or CNAME record may exist for either name.
  // www redirects to the bare domain (next.config.ts).
  "routes": [
    { "pattern": "gradleap.online", "custom_domain": true },
    { "pattern": "www.gradleap.online", "custom_domain": true }
  ],

  // Non-secret configuration. APP_URL is the public origin used in emailed
  // links, upload URLs and the Stripe return URL.
  // Account email (confirm your email, password reset) goes out over SMTP
  // from the Hostinger mailbox no-reply@gradleap.online. Its password is the
  // SMTP_PASS secret; until that secret exists, no email is sent and new
  // accounts are confirmed on creation.
  "vars": {
    "APP_URL": "https://gradleap.online",
    "SMTP_USER": "no-reply@gradleap.online",
    "SMTP_HOST": "smtp.hostinger.com",
    "SMTP_PORT": "465",
    "EMAIL_FROM": "GradLeap <no-reply@gradleap.online>"
  },

  "observability": {
    "enabled": true
  }
}
