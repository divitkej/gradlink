rules_version = '2';

// GradLink Firestore security rules.
//
// The core invariant: a user's Firebase Auth uid IS their profile id. Every
// "is this mine?" check is therefore a direct id comparison, with no lookup.
//
// This replaces the previous Postgres setup where every table was readable and
// writable by the anonymous public key. Reads now require a signed-in account;
// writes are restricted to the row's owner.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(id) {
      return signedIn() && request.auth.uid == id;
    }

    function myRole() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role;
    }

    function isManager() {
      return signedIn() && myRole() == 'event_manager';
    }

    // Identity ------------------------------------------------------------
    // Any signed-in user can read profiles: names are needed to render
    // messages, scans and candidate lists.
    match /profiles/{profileId} {
      allow read:   if signedIn();
      allow create: if isMe(profileId);
      allow update: if isMe(profileId);
      allow delete: if false;
    }

    // Role documents are keyed by profile id, so ownership is the doc id.
    match /students/{profileId} {
      allow read:         if signedIn();
      allow create, update: if isMe(profileId);
      allow delete:       if false;
    }

    match /companies/{profileId} {
      allow read:         if signedIn();
      allow create, update: if isMe(profileId);
      allow delete:       if false;
    }

    match /colleges/{profileId} {
      allow read:         if signedIn();
      allow create, update: if isMe(profileId);
      allow delete:       if false;
    }

    // Events --------------------------------------------------------------
    // Reading a registration across every event (to list "my events") is a
    // collection-group query, which rules match separately from the nested
    // path below. You may only find your own.
    match /{path=**}/registrations/{profileId} {
      allow read: if isMe(profileId);
    }

    match /events/{eventId} {
      allow read: if signedIn();

      // Any college can create an event, but only its owner may edit it.
      allow create: if isManager() && request.resource.data.created_by == request.auth.uid;
      allow update: if signedIn() && resource.data.created_by == request.auth.uid;
      allow delete: if false;

      // A user manages their own registration; managers can check anyone in.
      match /registrations/{profileId} {
        allow read:           if signedIn();
        allow create, update: if isMe(profileId) || isManager();
        allow delete:         if isManager();
      }

      // Scans are append-only, and you can only record a scan you performed.
      match /scans/{scanId} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.scanner_profile_id == request.auth.uid;
        allow update, delete: if false;
      }

      // A shortlist entry belongs to the company that made it.
      match /shortlists/{entryId} {
        allow read:           if signedIn();
        allow create, update: if signedIn() && request.resource.data.company_id == request.auth.uid;
        allow delete:         if false;
      }

      // Per-student analytics: the student owns their row, managers may recompute.
      match /analytics/{studentId} {
        allow read:           if signedIn();
        allow create, update: if isMe(studentId) || isManager();
        allow delete:         if false;
      }
    }

    // Messaging -----------------------------------------------------------
    // Only the two people in a conversation can read it.
    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
                    && request.resource.data.sender_profile_id == request.auth.uid
                    && request.auth.uid in request.resource.data.participants;

      // The recipient may only ever flip read_at — never edit the message text.
      allow update: if signedIn()
                    && resource.data.receiver_profile_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_at']);

      allow delete: if false;
    }

    // Checklists ----------------------------------------------------------
    // The item library is read-only to clients; managers seed it server-side.
    match /checklist_items/{itemId} {
      allow read:  if signedIn();
      allow write: if isManager();
    }

    match /checklist_progress/{progressId} {
      allow read:           if signedIn() && resource.data.profile_id == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.profile_id == request.auth.uid;
      allow delete:         if false;
    }

    // Billing -------------------------------------------------------------
    // Subscriptions are written ONLY by the Stripe webhook via the Admin SDK,
    // which bypasses these rules. A college can read its own plan so the
    // dashboard knows what to unlock, but cannot write one — that is what
    // makes a paid plan impossible to forge from the browser.
    match /subscriptions/{profileId} {
      allow read:  if isMe(profileId);
      allow write: if false;
    }

    // Kept for one-off purchases (e.g. a single-event report). Same rule.
    match /orders/{orderId} {
      allow read:  if signedIn() && resource.data.profile_id == request.auth.uid;
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
