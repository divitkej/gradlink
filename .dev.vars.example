# Local server configuration for GradLink (Cloudflare Workers + Neon).
#
#   cp .dev.vars.example .dev.vars
#
# .dev.vars is git-ignored. It's read by `npm run dev` (via
# initOpenNextCloudflareForDev), `npm run preview`, and the db:* scripts.
# In production the same names are set as Worker secrets:
#   npx wrangler secret put <NAME>

# Neon → your project → Connect → "Pooled connection" string.
DATABASE_URL=<NEON_DATABASE_URL>

# Signs session cookies. At least 32 random characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<AUTH_SECRET>

# Optional. Public origin used in password-reset links; defaults to the request origin.
APP_URL=http://localhost:3000

# Account email (confirm your email, password reset). Optional locally: with
# `npm run dev` the links are printed to the console instead. SMTP needs the
# Workers runtime, so real mail only goes out from `npm run preview` or deploy.
SMTP_USER=you@gmail.com
SMTP_PASS=<GMAIL_APP_PASSWORD>
# Or, once there is a verified domain, Resend instead of SMTP:
# RESEND_API_KEY=<RESEND_API_KEY>
# EMAIL_FROM=GradLink <no-reply@your-verified-domain.example>

# Owner pages under /admin: the owner dashboard and college domain approvals.
# Comma-separated. These emails also skip the sign-up email rules, so set this
# first, then sign up with the email straight away.
ADMIN_EMAILS=<YOUR_EMAIL>

# Optional — only needed to test the Placement Pro upgrade.
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>
STRIPE_PRICE_PRO=<STRIPE_PRICE_ID>

