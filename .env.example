# Build-time, PUBLIC configuration only — values here are inlined into the
# browser bundle and the Worker at build time. Never put secrets in .env files.
#
# Server secrets (DATABASE_URL, AUTH_SECRET, …) live in .dev.vars locally
# (see .dev.vars.example) and as Wrangler secrets in production.

# Canonical site URL for Open Graph/Twitter metadata. Defaults to the live
# workers.dev address in lib/site.ts when unset.
NEXT_PUBLIC_SITE_URL=https://gradlink.<your-subdomain>.workers.dev
