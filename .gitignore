# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare / Wrangler — .dev.vars holds local secrets
.dev.vars*
!.dev.vars.example
.wrangler/
/.open-next/
cloudflare-env.d.ts

# vercel
.vercel

# migration secrets — the real (unscrubbed) data export and any service account key
/migration/.private/

# typescript
*.tsbuildinfo
next-env.d.ts
